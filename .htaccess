ErrorDocument 404 /404.html
AddType text/calendar .ics
DirectoryIndex index.html index.php

# One address for the site: www goes to the bare domain.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.phillyafterschool\.org$ [NC]
RewriteRule ^ https://phillyafterschool.org%{REQUEST_URI} [R=301,L]
# The short addresses in the QR codes on the week card and the day-camp card.
RewriteRule ^w/?$ /?utm_source=week_card&utm_medium=qr [NC,R=302,L]
RewriteRule ^d/?$ /days-off/?utm_source=dayoff_card&utm_medium=qr [NC,R=302,L]
</IfModule>
