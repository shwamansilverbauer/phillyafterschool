RewriteRule ^summer-camps/mister-johns-music-camp/?$ /programs/mister-johns-music/#summer [NE,R=301,L]
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^summer-camps/music-theatre-philly-camp/?$ /programs/music-theatre-philly/?%1#summer [NE,QSD,R=301,L]
RewriteRule ^summer-camps/music-theatre-philly-camp/?$ /programs/music-theatre-philly/#summer [NE,R=301,L]
