ErrorDocument 404 /404.html
AddType text/calendar .ics
DirectoryIndex index.html index.php

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), geolocation=(self)"
<FilesMatch "\.woff2$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(html|ics)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
AddType font/woff2 .woff2

# One address for the site: www goes to the bare domain.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.phillyafterschool\.org$ [NC]
RewriteRule ^ https://phillyafterschool.org%{REQUEST_URI} [R=301,L]
# Kids' Playground was called the Passport at first.
RewriteRule ^passport/?$ /kids-playground/ [R=301,L]
RewriteRule ^kids-corner/?$ /kids-playground/ [R=301,L]
RewriteRule ^features/kids-corner/?$ /features/kids-playground/ [R=301,L]
# The site's other addresses all lead here, page for page (the certificate check on each is left alone).
RewriteCond %{HTTP_HOST} ^(www\.)?(phillyafterschool\.com)$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://phillyafterschool.org%{REQUEST_URI} [R=301,L]
# The short addresses in the QR codes on the week card and the day-camp card.
RewriteRule ^w/?$ /?utm_source=week_card&utm_medium=qr [NC,R=302,L]
RewriteRule ^d/?$ /days-off/?utm_source=dayoff_card&utm_medium=qr [NC,R=302,L]
# A school that has been added: its old "not covered yet" address goes to its page.
RewriteRule ^schools/ad-prima-charter-school-2/?$ /ad-prima/ [R=301,L]
RewriteRule ^schools/alain-locke-school/?$ /locke/ [R=301,L]
