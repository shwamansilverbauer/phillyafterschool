ErrorDocument 404 /404.html
AddType text/calendar .ics
DirectoryIndex index.html index.php

# One address for the site: www goes to the bare domain.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.phillyafterschool\.org$ [NC]
RewriteRule ^ https://phillyafterschool.org%{REQUEST_URI} [R=301,L]
# The site's other addresses all lead here, page for page (the certificate check on each is left alone).
RewriteCond %{HTTP_HOST} ^(www\.)?(phillyafterschool\.com)$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://phillyafterschool.org%{REQUEST_URI} [R=301,L]
# The short addresses in the QR codes on the week card and the day-camp card.
RewriteRule ^w/?$ /?utm_source=week_card&utm_medium=qr [NC,R=302,L]
RewriteRule ^d/?$ /days-off/?utm_source=dayoff_card&utm_medium=qr [NC,R=302,L]
# A school that has been added: its old "not covered yet" address goes to its page.
RewriteRule ^schools/christopher-columbus-charter-school/?$ /columbus-charter/ [R=301,L]
RewriteRule ^schools/eliza-b-kirkbride-school/?$ /kirkbride/ [R=301,L]
RewriteRule ^schools/fanny-jackson-coppin-school/?$ /coppin/ [R=301,L]
RewriteRule ^schools/general-george-a-mccall-school/?$ /mccall/ [R=301,L]
RewriteRule ^schools/george-w-nebinger-school/?$ /nebinger/ [R=301,L]
RewriteRule ^schools/southwark-school/?$ /southwark/ [R=301,L]
RewriteRule ^schools/vare-washington-school/?$ /vare-washington/ [R=301,L]
RewriteRule ^schools/william-m-meredith-school/?$ /meredith/ [R=301,L]
# A day off that has passed: its own page leads to the list of days still to come.
RewriteRule ^days-off/staff-professional-development-2026-10-09/?$ /days-off/ [R=301,L]
RewriteRule ^days-off/indigenous-peoples-day-2026-10-12/?$ /days-off/ [R=301,L]
# A summer camp tied to a program is on the program's page, under Summer (a query string, such as an email's tags, stays ahead of the #).
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^summer-camps/philly-art-center/?$ /programs/philly-art-center-qv/?%1#summer [NE,QSD,R=301,L]
RewriteRule ^summer-camps/philly-art-center/?$ /programs/philly-art-center-qv/#summer [NE,R=301,L]
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^summer-camps/fleisher-art-memorial-camp/?$ /programs/fleisher-art-memorial/?%1#summer [NE,QSD,R=301,L]
